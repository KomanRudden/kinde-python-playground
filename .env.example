# ---------------------------------------------------------------------------
# Kinde application (Settings > Applications > [Back-end web app] > Details)
# ---------------------------------------------------------------------------
KINDE_HOST=https://your-business.kinde.com
KINDE_CLIENT_ID=
# Leave empty to run as a public client (PKCE only)
KINDE_CLIENT_SECRET=
# Optional: request an access token for one of your APIs
KINDE_AUDIENCE=

# Where each app is served. Register both callback URLs in Kinde:
#   http://localhost:5050/callback  and  http://localhost:8000/callback
# and both logout URLs:
#   http://localhost:5050  and  http://localhost:8000
PLAYGROUND_FLASK_BASE_URL=http://localhost:5050
PLAYGROUND_FASTAPI_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Management API (Settings > Applications > [Machine to machine app])
# Optional: enables the Management API console and the setup check.
# ---------------------------------------------------------------------------
KINDE_MANAGEMENT_CLIENT_ID=
KINDE_MANAGEMENT_CLIENT_SECRET=
# Defaults to the host of KINDE_HOST
KINDE_MANAGEMENT_DOMAIN=

# Allow the Management console to create and delete resources (users, orgs, ...)
PLAYGROUND_ALLOW_MUTATIONS=false

# ---------------------------------------------------------------------------
# Playground behaviour
# ---------------------------------------------------------------------------
# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PLAYGROUND_SESSION_SECRET=

# oauth (sync OAuth), async (AsyncOAuth) or smart (SmartOAuth via create_oauth_client)
PLAYGROUND_CLIENT_MODE=oauth
# Read permissions, roles and flags from the Account API instead of token claims
PLAYGROUND_FORCE_API=false
# Shows "reveal token" buttons on the Tokens page. Never enable in production.
PLAYGROUND_DEBUG=false
PLAYGROUND_LOG_LEVEL=INFO

# Keys used by the protected-route examples. Create them in Kinde to see them granted.
PLAYGROUND_DEMO_PERMISSION=read:reports
PLAYGROUND_DEMO_ROLE=admin
PLAYGROUND_DEMO_FLAG=beta_dashboard
PLAYGROUND_DEMO_ENTITLEMENT=pro_reports
